#
# To clean up the repo, run `git clean -Xdf`
# NOTE: This is destructive and will wipe anything besides the source tree!
#

# Ignore everything in the root directory, whitelist stuff later
/*/
/*

# Python bytecode from tools/ (the supervisor CLI imports its sibling)
__pycache__/
*.pyc

# Ignore Kate editor temp files
*.kate-swp

# Ignore local patches
*.patch
*.rej
*.orig

# Ignore clang-analyzer output
*.plist

# Explicitly track source directories
!/include
!/src
!/tools
# Third-party sources live outside src/ so the host build's recursive wildcard
# over SRCDIR cannot reach them (see project.mk, TINYSSH_DIR).
!/third_party

# Explicitly track build system
!/Makefile
!/project.mk
!/CMakeLists.txt
!/Doxyfile

# Explicitly track build scripts
!/build_virtpass.ps1

# Explicitly track CI infrastructure
!/.github
!/.gitlab-ci.yml

# Explicitly track agent/项目文档（issues/ 按 AGENTS.md 约定不入 Git）
!/AGENTS.md
!/docs/
!/workflows/
# Agent skills kept with the project (the harness also installs them under
# ~/.agents/skills; this copy is what gets reviewed and carried around)
!/skills

# Explicitly track repository metadata
!/README*
!/LICENSE*
!/.mailmap
!/.gitignore
!/.clang-format
