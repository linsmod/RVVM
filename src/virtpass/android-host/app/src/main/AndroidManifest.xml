<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:name=".RvvmHost"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".SimpleLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Guest windows are one document task per app, managed from
             SimpleLauncherActivity: NEW_DOCUMENT|MULTIPLE_TASK creates a task
             per run, and re-entry finds the existing task by its base intent
             action (the app name) and brings it forward. documentLaunchMode
             is deliberately NOT used: its task lookup matches by affinity
             first, and every GuestActivity shares the default (package)
             affinity - all guests would collapse into the first task. -->
        <activity
            android:name=".GuestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|keyboardHidden">
        </activity>

        <!-- Exported so `adb shell am start` can drive a run: the shell uid
             (2000) is refused when starting a non-exported activity, which
             silently made the documented adb launch command fail on current
             Android. EXTRA_GUEST_APP / EXTRA_GUEST_ARGS are the whole reason -
             a host test is then one am start instead of driving the picker by
             hand. No intent-filter (it must not add a launcher entry) and no
             permission: this is a development console. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
        </activity>

    </application>

</manifest>
