<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Two tabs: the guest's render target (SurfaceView + console overlay)
         and the persistent TTY console (TextureView). The flipper swaps
         between them; both stay alive, so the TTY keeps its screen while
         graphics run in the other tab. -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: graphics -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <SurfaceView
                android:id="@+id/surfaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Tap toggles word wrap. Two nested scrollers so the unwrapped
                 (single-line) mode can extend horizontally: the outer view
                 scrolls X, the inner one Y. -->
            <HorizontalScrollView
                android:id="@+id/logOverlayScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#C0000000"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/logOverlayVScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/logOverlayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"
                        android:typeface="monospace" />

                </ScrollView>

            </HorizontalScrollView>

        </FrameLayout>

        <!-- Tab 2: TTY console, rendered by a TextureView + Canvas -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000">

            <TextureView
                android:id="@+id/ttyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabGraphicsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_graphics"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/tabConsoleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_console" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guest_app_label"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/guestAppSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/runButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/run_guest"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/suspendButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/suspend_guest"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stop_guest"
                android:enabled="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textSize="12sp"
            android:background="#E0E0E0"
            android:padding="4dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

</LinearLayout>