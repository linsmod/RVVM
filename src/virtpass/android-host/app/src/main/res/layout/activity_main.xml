<?xml version="1.0" encoding="utf-8"?>
<!--
  Two layers in one window:

    layer 0 - the console: the TTY the guest's fd 1/2 and the keyboard are
              parsed into, plus the terminal key bar and the run controls.
              It owns the whole workspace and is never hidden.
    layer 1 - the guest's graphics output: a floating card in the top-right
              corner, a caption bar over a SurfaceView. MainActivity lifts the
              surface above the window (setZOrderMediaOverlay), so the card can
              be dragged anywhere over the console or expanded to fill the
              workspace, and the console simply stays behind it.

  The caption bar is the only host-owned part of the card. Nothing drawn in
  this window can cover the surface itself, so the bar sits *above* the video
  area instead of over it, and a touch on the video area is forwarded to the
  guest like before.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workspace"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Console render target: a TextureView painted by MainActivity.drawTty().
             An invisible 1x1 EditText is added to ttyViewport in code: it is the
             keyboard/IME focus target, see MainActivity.initTtyInput(). -->
        <FrameLayout
            android:id="@+id/ttyViewport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF000000">

            <TextureView
                android:id="@+id/ttyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Keys a soft keyboard cannot produce. Text, Enter and Backspace
             come from the keyboard/app bar; these are what a shell needs for
             line editing (arrows) and interrupting (^C), and they are the
             only way to reach them on a touch-only device.
             blocksDescendants: the buttons must never take keyboard focus
             away from the console's input field. -->
        <LinearLayout
            android:id="@+id/ttyKeyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1C1C1C"
            android:descendantFocusability="blocksDescendants"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/ttyKeyEsc"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_esc"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyTab"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_tab"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyCtrlC"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_ctrl_c"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyLeft"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_left"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyUp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_up"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyDown"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_down"
                android:textSize="12sp" />

            <Button
                android:id="@+id/ttyKeyRight"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/tty_key_right"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- The taskbar, Windows-style: the Start button opens the launcher
             menu (every guest app in assets, tapping one starts a NEW run);
             the strip next to it holds one chip per running window (tap =
             focus / restore, long-press = close); SUSPEND/STOP act on the
             focused window. The chips live in a horizontal scroller so four
             guests still fit on a phone. -->
        <LinearLayout
            android:id="@+id/taskbarRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1C1C1C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="56dp"
                android:text="@string/start_button"
                android:textSize="14sp" />

            <!-- Chips wrap into rows (FlowLayout) and the strip grows with
                 them; past 3/5 of the screen it stops growing and scrolls. -->
            <com.rvvm.android.BoundedScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.rvvm.android.FlowLayout
                    android:id="@+id/glTaskbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.rvvm.android.BoundedScrollView>

            <Button
                android:id="@+id/suspendButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="@string/suspend_guest"
                android:textSize="12sp"
                android:enabled="false"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="@string/stop_guest"
                android:textSize="12sp"
                android:enabled="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textSize="12sp"
            android:background="#E0E0E0"
            android:padding="4dp" />

    </LinearLayout>

    <!-- The floating graphics window. It is a viewport onto the pinned 720p
         panel (see MainActivity.PANEL_W/H), not the panel itself, so its size
         only decides how big the guest's screen is shown: the picture is fitted
         into whatever video area the card ends up with (see FitFrameLayout), so
         the card can be any shape - a maximized window on a portrait phone
         letterboxes the guest's frame instead of stretching it.

         The size below is 16:9 to match the panel, which is what the window
         wants to open at, not a constraint on it.

         The 1dp padding is the window's border: the surface composites above
         this window, so the frame drawable is only visible in the ring the
         card keeps free around its content. See gl_window_frame.xml.

         The size below is the window's *shown* state. Until the guest has a
         frame to put in it, MainActivity lays the card out at 1x1 px with this
         frame, the title bar and the shadow taken away, so a guest that never
         draws never puts an empty window on screen - while its surface, which
         has to exist from the start, stays alive. -->
    <!-- The guest window(s) are inflated from gl_window.xml in Java
         (GlWindowCard) - one per run, added to this container at runtime. -->

</FrameLayout>
