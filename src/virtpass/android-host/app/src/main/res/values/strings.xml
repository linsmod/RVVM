<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">RVVM Android</string>
    <string name="guest_app_label">Guest App:</string>
    <string name="run_guest">Run</string>
    <string name="start_button">\u229E</string>
    <string name="stop_guest">Stop</string>
    <string name="suspend_guest">Suspend</string>
    <string name="resume_guest">Resume</string>

    <!-- Floating graphics window: its title bar. The window buttons are the
         Windows set and keep Windows' glyphs, written as escapes so the file
         stays ASCII-only: an en dash to minimize, a box to maximize and - once
         the window already fills the screen - the same box doubled to put it
         back, and a multiplication cross to close. -->
    <string name="gl_title">Guest</string>
    <string name="gl_btn_min">\u2013</string>
    <string name="gl_btn_max">\u25A1</string>
    <string name="gl_btn_restore">\u2750</string>
    <string name="gl_btn_close">\u2715</string>
    <string name="gl_btn_min_desc">Minimize window</string>
    <string name="gl_btn_max_desc">Maximize or restore window</string>
    <string name="gl_btn_close_desc">Close window</string>
    <!-- Taskbar entries, in the corner the window's own chip used to occupy: one
         per guest window that is minimized, and the way back to it. %1$s is the
         name of the guest the window belongs to. -->
    <string name="gl_taskbar_entry">\u2750 %1$s</string>

    <!-- Console keyboard bar: the terminal keys a soft keyboard cannot produce.
         The arrows are written as escapes so the file stays ASCII-only. -->
    <string name="tty_key_esc">Esc</string>
    <string name="tty_key_tab">Tab</string>
    <string name="tty_key_ctrl_c">^C</string>
    <string name="tty_key_left">\u2190</string>
    <string name="tty_key_up">\u2191</string>
    <string name="tty_key_down">\u2193</string>
    <string name="tty_key_right">\u2192</string>
</resources>
